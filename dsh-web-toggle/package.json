{
  "name": "dsh-web-toggle",
  "version": "0.3.0",
  "description": "按会话独立的联网开关：关掉后本会话的模型看不到 web_search / web_fetch、浏览器、MCP 等出网工具，shell 里的联网命令也会被拦下；带设置页、插件详情页与输入框小箭头三处可视化面板，可按会话配置保留的工具。Per-session web switch for DeepSeek Harness with a configuration panel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tests",
    "scripts/link-deps.mjs",
    "scripts/sync-to-profile.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "web-search",
    "web-fetch",
    "tool-restriction",
    "composer",
    "plugin",
    "settings",
    "configuration",
    "allowlist"
  ],
  "license": "MIT",
  "author": "AluminiumRanran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AluminiumRanran/dsh-web-toggle.git"
  },
  "homepage": "https://github.com/AluminiumRanran/dsh-web-toggle#readme",
  "bugs": {
    "url": "https://github.com/AluminiumRanran/dsh-web-toggle/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
