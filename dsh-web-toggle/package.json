{
  "name": "dsh-web-toggle",
  "version": "0.4.0",
  "description": "按会话独立的联网开关：每个工具可选保留 / 隐藏 / 内容检查，断网时隐藏联网通道、通用执行器逐次查内容，其余工具照常放行；带输入框小箭头、设置页侧边栏与插件详情页三处面板，模式分层（本任务 / 全局 / 出厂）。Per-session web switch for DeepSeek Harness: keep / hide / inspect per tool, layered per session and globally.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tests",
    "scripts/link-deps.mjs",
    "scripts/sync-to-profile.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "web-search",
    "web-fetch",
    "tool-restriction",
    "composer",
    "plugin",
    "settings",
    "configuration",
    "allowlist"
  ],
  "license": "MIT",
  "author": "AluminiumRanran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AluminiumRanran/dsh-web-toggle.git"
  },
  "homepage": "https://github.com/AluminiumRanran/dsh-web-toggle#readme",
  "bugs": {
    "url": "https://github.com/AluminiumRanran/dsh-web-toggle/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
