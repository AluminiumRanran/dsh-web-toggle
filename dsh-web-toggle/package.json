{
  "name": "dsh-web-toggle",
  "version": "0.6.0",
  "description": "按会话的断网开关：每个工具有四种模式——放行、拒绝（从列表移除）、检查（每次看参数）、调用时拒绝；没配置过的工具默认检查。面板分三处（输入框小箭头、设置页侧边栏、插件详情页）。 / A per-session network switch: every tool has one of four modes — keep, hide (drop from the list), inspect each call, or refuse each call; tools you never configured are inspected. Three panels: composer caret, settings sidebar, bundle detail page.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tests",
    "scripts/link-deps.mjs",
    "scripts/sync-to-profile.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "web-search",
    "web-fetch",
    "tool-restriction",
    "composer",
    "plugin",
    "settings",
    "configuration",
    "allowlist"
  ],
  "license": "MIT",
  "author": "AluminiumRanran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AluminiumRanran/dsh-web-toggle.git"
  },
  "homepage": "https://github.com/AluminiumRanran/dsh-web-toggle#readme",
  "bugs": {
    "url": "https://github.com/AluminiumRanran/dsh-web-toggle/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
